<view class="page">
  <view class="card">
    <view class="form-item">
      <text class="label">物品标题 <text class="req">*</text></text>
      <input class="input" value="{{title}}" bindinput="onInput" data-field="title"
             placeholder="如：九成新《数据结构》教材" maxlength="64" />
    </view>

    <view class="form-item">
      <text class="label">物品分类</text>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}"
              bindchange="onCategoryChange">
        <view class="picker">{{categories[categoryIndex]}} ▾</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">期望换取</text>
      <input class="input" value="{{expectItem}}" bindinput="onInput" data-field="expectItem"
             placeholder="如：想换一个台灯 / 面议" maxlength="128" />
    </view>

    <view class="form-item">
      <text class="label">详细描述</text>
      <textarea class="textarea" value="{{description}}" bindinput="onInput" data-field="description"
                placeholder="描述物品的成新度、使用时长、瑕疵等" maxlength="500"
                show-confirm-bar="{{false}}" />
    </view>

    <view class="form-item">
      <text class="label">实物照片 <text class="req">*</text></text>
      <upload-grid value="{{images}}" max="{{9}}" bind:change="onImagesChange" />
    </view>
  </view>

  <view class="notice">发布内容需经管理员审核，审核通过后其他同学才能看到。请勿发布违规信息。</view>

  <view class="btns">
    <button class="btn-primary" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">
      提交发布
    </button>
  </view>
</view>
