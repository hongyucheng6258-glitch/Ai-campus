/* 发布表单通用样式（闲置） */
.form-item {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #606266;
  display: block;
  margin-bottom: 12rpx;
}

.req {
  color: #d9543f;
}

.input {
  width: 100%;
  height: 76rpx;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker {
  height: 76rpx;
  line-height: 76rpx;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #303133;
}

.textarea {
  width: 100%;
  height: 200rpx;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.notice {
  margin: 0 32rpx 24rpx;
  font-size: 24rpx;
  color: #e0a93f;
  line-height: 36rpx;
}

.btns {
  padding: 0 32rpx 60rpx;
}
