/* ============================================================
   梧桐校园 · 小程序全局样式
   暖色编辑风：梧桐绿(品牌) + 暖珊瑚(强调) + 暖纸底
   与 Web 端 / 后台端同一套设计语言。
   ============================================================ */
@import './styles/wutong.wxss';

page {
  background: #faf7f1;
  font-size: 28rpx;
  color: #35393d;
  line-height: 1.6;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(53, 57, 61, 0.06);
}

/* 主按钮 */
.btn-primary {
  background: #2f9e8a;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.btn-primary[disabled] {
  background: #a9cfc6;
}

/* 次要文字 */
.text-muted {
  color: #9a9ea4;
  font-size: 24rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #e6f4f0;
  color: #2f9e8a;
}
.tag-danger {
  background: #fbe6e1;
  color: #d9543f;
}
.tag-success {
  background: #e8f3ec;
  color: #4ca46a;
}
.tag-warning {
  background: #fbf1dc;
  color: #e0a93f;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #c0c4cc;
  padding: 80rpx 0;
  font-size: 26rpx;
}
