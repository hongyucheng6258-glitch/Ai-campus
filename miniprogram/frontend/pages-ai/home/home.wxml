<view class="page">
  <view class="hero">
    <view class="hero-title">🤖 AI 学习中心</view>
    <view class="hero-sub">答疑 · 错题 · 提纲 · PDF · 代码，一个入口全搞定</view>
  </view>

  <view wx:for="{{entries}}" wx:key="name" class="ai-card" bindtap="goEntry" data-item="{{item}}">
    <view class="ai-icon">{{item.icon}}</view>
    <view class="ai-body">
      <view class="ai-name">{{item.name}}</view>
      <view class="ai-desc">{{item.desc}}</view>
    </view>
    <view class="ai-arrow">›</view>
  </view>
</view>
