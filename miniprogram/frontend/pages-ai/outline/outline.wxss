/* 提纲生成页样式 */
.form-item {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #606266;
  display: block;
  margin-bottom: 12rpx;
}

.req {
  color: #d9543f;
}

.input {
  width: 100%;
  height: 76rpx;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.samples {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.sample-label {
  font-size: 24rpx;
  color: #909399;
  margin-right: 12rpx;
}

.tag.sample {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.btns {
  padding: 0 16rpx;
  display: flex;
}

.btns button {
  flex: 1;
  margin: 0 8rpx;
}

.btn-plain {
  background: #fff;
  color: #606266;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.answer {
  display: block;
  font-size: 26rpx;
  line-height: 46rpx;
  color: #606266;
  white-space: pre-wrap;
  word-break: break-all;
}

.copy {
  margin-top: 24rpx;
}
