/* 错题本样式 */
.tabs {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 12rpx;
  display: flex;
}

.tabs .tab {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin: 0 6rpx;
  font-size: 26rpx;
  color: #606266;
  background: #f3f0ea;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.tabs .tab.active {
  background: #2f9e8a;
  color: #fff;
}

.wq .head {
  display: flex;
  align-items: center;
}

.wq .head .time {
  margin-left: auto;
  font-size: 22rpx;
  color: #909399;
}

.wq .head .tag {
  margin-right: 12rpx;
}

.question {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #303133;
}

.ans-block {
  margin-top: 20rpx;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 20rpx;
}

.ans-label {
  font-size: 24rpx;
  color: #2f9e8a;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.ans-text {
  display: block;
  font-size: 26rpx;
  line-height: 42rpx;
  color: #606266;
  white-space: pre-wrap;
}

.source {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #c0c4cc;
}

.ops {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e7e3d9;
  display: flex;
  justify-content: space-around;
}

.ops .op {
  font-size: 26rpx;
  color: #606266;
}

.ops .op.primary {
  color: #2f9e8a;
}

.ops .op.danger {
  color: #d9543f;
}

.loading-tip {
  text-align: center;
  color: #c0c4cc;
  font-size: 24rpx;
  padding: 24rpx 0 120rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2f9e8a;
  color: #fff;
  font-size: 56rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(47, 158, 138, 0.35);
  z-index: 10;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.dialog {
  width: 620rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}

.field {
  width: 100%;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.field.area {
  height: 140rpx;
}

.quiz-body {
  max-height: 60vh;
  font-size: 26rpx;
  line-height: 44rpx;
  color: #606266;
  white-space: pre-wrap;
}

.dialog-btns {
  display: flex;
  margin-top: 24rpx;
}

.dialog-btns button {
  flex: 1;
  margin: 0 8rpx;
}

.btn-plain {
  background: #f3f0ea;
  color: #606266;
  border-radius: 44rpx;
  font-size: 30rpx;
}
