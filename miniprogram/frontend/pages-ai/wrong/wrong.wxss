/* 错题本样式 */
.tabs {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 12rpx;
  display: flex;
}

.tabs .tab {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin: 0 6rpx;
  font-size: 26rpx;
  color: #606266;
  background: #f3f0ea;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.tabs .tab.active {
  background: #2f9e8a;
  color: #fff;
}

.wq .head {
  display: flex;
  align-items: center;
}

.wq .head .time {
  margin-left: auto;
  font-size: 22rpx;
  color: #909399;
}

.wq .head .tag {
  margin-right: 12rpx;
}

.question {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #303133;
}

.ans-block {
  margin-top: 20rpx;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 20rpx;
}

.ans-label {
  font-size: 24rpx;
  color: #2f9e8a;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.ans-text {
  display: block;
  font-size: 26rpx;
  line-height: 42rpx;
  color: #606266;
  white-space: pre-wrap;
}

.source {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #c0c4cc;
}

.ops {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e7e3d9;
  display: flex;
  justify-content: space-around;
}

.ops .op {
  font-size: 26rpx;
  color: #606266;
}

.ops .op.primary {
  color: #2f9e8a;
}

.ops .op.danger {
  color: #d9543f;
}

.loading-tip {
  text-align: center;
  color: #c0c4cc;
  font-size: 24rpx;
  padding: 24rpx 0 120rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2f9e8a;
  color: #fff;
  font-size: 56rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(47, 158, 138, 0.35);
  z-index: 10;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.dialog {
  width: 620rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}

.field {
  width: 100%;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.field.area {
  height: 140rpx;
}

.quiz-body {
  max-height: 60vh;
  font-size: 26rpx;
  line-height: 44rpx;
  color: #606266;
  white-space: pre-wrap;
}

.dialog-btns {
  display: flex;
  margin-top: 24rpx;
}

.dialog-btns button {
  flex: 1;
  margin: 0 8rpx;
}

.btn-plain {
  background: #f3f0ea;
  color: #606266;
  border-radius: 44rpx;
  font-size: 30rpx;
}

/* ---------- v2/v3 新增样式 ---------- */

/* 今日复习入口 */
.today-bar {
  display: flex;
  align-items: center;
  background: #e8f6f2;
  margin: 16rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
}
.today-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2f9e8a;
}
.today-num {
  margin-left: auto;
  font-size: 26rpx;
  color: #2f9e8a;
}
.today-arrow {
  margin-left: 12rpx;
  color: #2f9e8a;
  font-size: 30rpx;
}

/* 掌握状态徽标 */
.st {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}
.st-pending { background: #fde8e8; color: #d9543f; }
.st-reviewing { background: #fdf3e0; color: #b88230; }
.st-basic { background: #e8f4fb; color: #2b6cb0; }
.st-mastered { background: #e4f6e6; color: #2f9e8a; }

/* 复习弹窗 */
.review-q {
  font-size: 30rpx;
  line-height: 46rpx;
  color: #303133;
  margin-bottom: 16rpx;
}
.level-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.level-item {
  width: 46%;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.level-item.active {
  background: #2f9e8a;
}
.level-item.active .lv-label,
.level-item.active .lv-desc {
  color: #fff;
}
.lv-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
}
.lv-desc {
  font-size: 22rpx;
  color: #909399;
  margin-top: 6rpx;
}

/* 今日复习列表 */
.today-list {
  max-height: 60vh;
}
.today-empty {
  text-align: center;
  color: #909399;
  font-size: 26rpx;
  padding: 40rpx 0;
}
.today-item {
  display: flex;
  align-items: center;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.today-q {
  flex: 1;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #303133;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.today-ops .op {
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 展开详情元信息 */
.meta-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 16rpx;
  gap: 12rpx;
}
.meta {
  font-size: 22rpx;
  color: #909399;
}
.meta-warn {
  color: #b88230;
}

/* 操作按钮类型 */
.ops .op.success {
  color: #2f9e8a;
  font-weight: 600;
}
.ops .op.warn {
  color: #b88230;
}
