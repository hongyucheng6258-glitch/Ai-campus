<view class="page">
  <!-- 今日复习 + 薄弱点入口 -->
  <view class="top-bars">
    <view class="today-bar" bindtap="openTodayReview">
      <text class="today-title">📖 今日复习</text>
      <text class="today-num">{{stats.todayPending > 0 ? '待复习 ' + stats.todayPending + ' 道' : '今日无待复习'}}</text>
      <text class="today-arrow">›</text>
    </view>
    <view class="weak-bar" bindtap="openWeak">
      <text class="weak-title">📉 薄弱点</text>
      <text class="today-arrow">›</text>
    </view>
  </view>

  <!-- 学科筛选条 -->
  <scroll-view class="tabs" scroll-x enable-flex>
    <view class="tab {{activeSubject === '' ? 'active' : ''}}"
          bindtap="switchSubject" data-subject="">全部</view>
    <view wx:for="{{subjects}}" wx:key="*this"
          class="tab {{activeSubject === item ? 'active' : ''}}"
          bindtap="switchSubject" data-subject="{{item}}">{{item}}</view>
  </scroll-view>

  <!-- 错题列表 -->
  <view wx:for="{{list}}" wx:key="id" class="card wq">
    <view class="head">
      <text class="tag">{{item.subject}}</text>
      <text wx:if="{{item.tag}}" class="tag tag-warning">{{item.tag}}</text>
      <text class="st {{item.statusCls}}">{{item.statusLabel}}</text>
      <text class="time">{{item.timeText}}</text>
    </view>

    <view class="question" bindtap="toggleExpand" data-id="{{item.id}}">{{item.question}}</view>

    <!-- 展开后显示答案与解析 + AI 讲解 -->
    <block wx:if="{{expandId === item.id}}">
      <view class="ans-block">
        <view class="ans-label">我的答案</view>
        <text class="ans-text" selectable>{{item.myAnswer || '（未填写）'}}</text>
      </view>
      <view class="ans-block">
        <view class="ans-label">参考答案</view>
        <text class="ans-text" selectable>{{item.correctAnswer || '（未填写）'}}</text>
      </view>
      <view class="ans-block">
        <view class="ans-label">解析</view>
        <text class="ans-text" selectable>{{item.analysis || '（未填写）'}}</text>
      </view>
      <view class="meta-line">
        <text wx:if="{{item.wrongCount}}" class="meta">错{{item.wrongCount}}次</text>
        <text wx:if="{{item.consecutiveCorrectCount}}" class="meta">连续答对{{item.consecutiveCorrectCount}}次</text>
        <text wx:if="{{item.analyzeStatus === 1}}" class="meta meta-warn">AI整理失败</text>
        <text wx:if="{{item.source}}" class="source">来源：{{item.source}}</text>
      </view>
      <view class="ops sub-ops">
        <view wx:if="{{item.analyzeStatus === 1}}" class="op warn" bindtap="retryAnalyze" data-id="{{item.id}}">AI 整理</view>
        <view class="op danger" bindtap="removeItem" data-id="{{item.id}}">删除</view>
      </view>
    </block>

    <view class="ops">
      <view class="op success" bindtap="startReviewFromCard" data-id="{{item.id}}">复习</view>
      <view class="op primary" bindtap="openPractice" data-id="{{item.id}}">练习</view>
      <view class="op" bindtap="toggleExpand" data-id="{{item.id}}">
        {{expandId === item.id ? '收起' : '更多'}}
      </view>
    </view>
  </view>

  <view wx:if="{{inited && list.length === 0}}" class="empty">
    <view class="empty-icon">📕</view>
    <view class="empty-text">错题本还是空的，点右下角 ＋ 收录一道</view>
  </view>
  <view wx:if="{{loading}}" class="loading-tip">加载中…</view>
  <view wx:elif="{{!hasMore && list.length > 0}}" class="loading-tip">共 {{total}} 道错题</view>

  <!-- 悬浮新增按钮 -->
  <view class="fab" bindtap="openAdd">＋</view>

  <!-- 今日复习弹窗 -->
  <view wx:if="{{showToday}}" class="mask" bindtap="closeToday">
    <view class="dialog" catchtap="stopPropagation">
      <view class="dialog-title">📖 今日待复习</view>
      <scroll-view class="today-list" scroll-y>
        <view wx:if="{{todayError}}" class="today-empty">加载失败，请稍后重试</view>
        <view wx:elif="{{todayList.length === 0}}" class="today-empty">🎉 今日没有待复习的错题</view>
        <view wx:for="{{todayList}}" wx:key="id" class="today-item">
          <view class="today-q">{{item.question}}</view>
          <view class="today-ops">
            <view class="op success" bindtap="startReviewFromToday" data-id="{{item.id}}">开始复习</view>
          </view>
        </view>
      </scroll-view>
      <view class="dialog-btns">
        <button class="btn-plain" bindtap="generatePlan">🤖 AI 复习计划</button>
        <button class="btn-primary" bindtap="closeToday">关闭</button>
      </view>
    </view>
  </view>

  <!-- 复习弹窗（含 AI 讲解入口） -->
  <view wx:if="{{showReview && reviewItem}}" class="mask" bindtap="closeReview">
    <view class="dialog" catchtap="stopPropagation">
      <view class="dialog-title">🔁 复习 · 选择掌握程度</view>
      <scroll-view class="quiz-body" scroll-y>
        <view class="review-q">{{reviewItem.question}}</view>
        <view class="ans-block">
          <view class="ans-label">我的答案</view>
          <text class="ans-text" selectable>{{reviewItem.myAnswer || '（未填写）'}}</text>
        </view>
        <view class="ans-block">
          <view class="ans-label">参考答案</view>
          <text class="ans-text" selectable>{{reviewItem.correctAnswer || '（未填写）'}}</text>
        </view>
        <view class="level-grid">
          <view wx:for="{{levels}}" wx:key="v"
                class="level-item {{reviewLevel === item.v ? 'active' : ''}}"
                bindtap="chooseLevel" data-v="{{item.v}}">
            <view class="lv-label">{{item.label}}</view>
            <view class="lv-desc">{{item.desc}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="dialog-btns">
        <button class="btn-plain" bindtap="explainWrong">🤖 AI 讲解</button>
        <button class="btn-primary" bindtap="submitReview" loading="{{reviewSubmitting}}"
                disabled="{{reviewSubmitting}}">提交反馈</button>
      </view>
    </view>
  </view>

  <!-- AI 讲解弹窗 -->
  <view wx:if="{{showExplain}}" class="mask" bindtap="closeExplain">
    <view class="dialog" catchtap="stopPropagation">
      <view class="dialog-title">🤖 AI 讲解</view>
      <scroll-view class="md-body" scroll-y>
        <view wx:if="{{explainLoading}}" class="md-loading">AI 正在讲解，请稍候…</view>
        <view wx:elif="{{explainFailed}}" class="md-fail">
          <view>讲解失败：AI 服务暂不可用或返回异常</view>
          <view class="op primary md-retry" bindtap="retryExplain">重试</view>
        </view>
        <rich-text wx:else nodes="{{explainHtml}}" />
      </scroll-view>
      <view class="dialog-btns">
        <button class="btn-plain" bindtap="copyExplain">复制</button>
        <button class="btn-primary" bindtap="closeExplain">关闭</button>
      </view>
    </view>
  </view>

  <!-- AI 复习计划弹窗 -->
  <view wx:if="{{showPlan}}" class="mask" bindtap="closePlan">
    <view class="dialog" catchtap="stopPropagation">
      <view class="dialog-title">🗓️ AI 复习计划</view>
      <scroll-view class="md-body" scroll-y>
        <view wx:if="{{planLoading}}" class="md-loading">AI 正在制定复习计划，请稍候…</view>
        <view wx:elif="{{planFailed}}" class="md-fail">
          <view>生成失败：AI 服务暂不可用或今日无待复习错题</view>
          <view class="op primary md-retry" bindtap="retryPlan">重试</view>
        </view>
        <rich-text wx:else nodes="{{planHtml}}" />
      </scroll-view>
      <view class="dialog-btns">
        <button class="btn-plain" bindtap="copyPlan">复制</button>
        <button class="btn-primary" bindtap="closePlan">关闭</button>
      </view>
    </view>
  </view>

  <!-- 薄弱点弹窗 -->
  <view wx:if="{{showWeak}}" class="mask" bindtap="closeWeak">
    <view class="dialog" catchtap="stopPropagation">
      <view class="dialog-title">📉 薄弱知识点</view>
      <scroll-view class="quiz-body" scroll-y>
        <view wx:if="{{weak.knowledgePoints.length === 0 && weak.errorReasons.length === 0}}"
              class="today-empty">暂无统计，先收录一些错题吧</view>
        <block wx:else>
          <view class="weak-sec-title">高频知识点</view>
          <view class="weak-tags">
            <text wx:for="{{weak.knowledgePoints}}" wx:key="name"
                  class="weak-tag {{item.pendingCount > 0 ? 'warn' : ''}}">
              {{item.name}} ×{{item.wrongCount}}
            </text>
          </view>
          <view class="weak-sec-title">主要错因</view>
          <view class="weak-tags">
            <text wx:for="{{weak.errorReasons}}" wx:key="reason" class="weak-tag">
              {{item.reason}} ×{{item.count}}
            </text>
          </view>
        </block>
      </scroll-view>
      <view class="dialog-btns">
        <button class="btn-primary" bindtap="closeWeak">关闭</button>
      </view>
    </view>
  </view>

  <!-- 新增错题弹窗 -->
  <view wx:if="{{showAdd}}" class="mask" bindtap="closeAdd">
    <view class="dialog" catchtap="stopPropagation">
      <view class="dialog-title">⚡ 快速收录（仅题目必填）</view>
      <input class="field" placeholder="学科（留空=待整理，如：数据结构）" value="{{form.subject}}"
             bindinput="onFormInput" data-field="subject" />
      <textarea class="field area" placeholder="题目（必填）" value="{{form.question}}"
                bindinput="onFormInput" data-field="question" show-confirm-bar="{{false}}" />
      <textarea class="field area" placeholder="我的答案（选填）" value="{{form.myAnswer}}"
                bindinput="onFormInput" data-field="myAnswer" show-confirm-bar="{{false}}" />
      <textarea class="field area" placeholder="正确答案（选填）" value="{{form.answer}}"
                bindinput="onFormInput" data-field="answer" show-confirm-bar="{{false}}" />
      <textarea class="field area" placeholder="解析（选填）" value="{{form.analysis}}"
                bindinput="onFormInput" data-field="analysis" show-confirm-bar="{{false}}" />
      <view class="dialog-btns">
        <button class="btn-plain" bindtap="closeAdd">取消</button>
        <button class="btn-primary" bindtap="submitAdd" loading="{{submitting}}"
                disabled="{{submitting}}">保存</button>
      </view>
    </view>
  </view>

  <!-- AI 同类题练习弹窗（v4 练习模式） -->
  <view wx:if="{{showPractice}}" class="mask" bindtap="closePractice">
    <view class="dialog" catchtap="stopPropagation">
      <view class="dialog-title">🤖 AI 同类题练习</view>
      <scroll-view class="quiz-body" scroll-y>
        <view wx:if="{{practiceLoading}}" class="md-loading">AI 正在出题，请稍候…</view>
        <view wx:elif="{{practiceFailed}}" class="md-fail">
          <view>出题失败：AI 服务暂不可用或返回异常</view>
          <view class="op primary md-retry" bindtap="openPractice" data-id="{{practiceWqId}}">重试</view>
        </view>
        <block wx:elif="{{practice}}">
          <view class="practice-q">{{practice.question}}</view>

          <!-- 选择题选项 -->
          <view wx:if="{{practice.options.length}}">
            <view wx:for="{{practice.options}}" wx:key="text"
                  class="p-option {{practiceAnswer === item.letter ? 'picked' : ''}} {{practiceSubmitted ? 'disabled' : ''}}"
                  bindtap="choosePracticeOption" data-item="{{item}}">
              {{item.text}}
            </view>
          </view>
          <!-- 填空/简答作答 -->
          <textarea wx:else class="field area" placeholder="输入你的答案…" value="{{practiceAnswer}}"
                    disabled="{{practiceSubmitted}}" bindinput="onPracticeInput"
                    show-confirm-bar="{{false}}" />

          <!-- 判对错结果 -->
          <view wx:if="{{practiceSubmitted}}" class="judge {{practiceJudged === true ? 'right' : (practiceJudged === false ? 'wrong' : '')}}">
            <block wx:if="{{practiceJudged === true}}">✅ 答对了，很棒！</block>
            <block wx:elif="{{practiceJudged === false}}">❌ 答错了，正确答案：{{practice.answer}}</block>
            <block wx:else>AI 未提供标准答案，请参考解析核对</block>
          </view>

          <!-- 解析 -->
          <view wx:if="{{practiceSubmitted && practice.analysis}}" class="ans-block">
            <view class="ans-label">解析</view>
            <rich-text class="ans-text" nodes="{{practiceAnalysisHtml}}" />
          </view>

          <view class="dialog-btns">
            <block wx:if="{{!practiceSubmitted}}">
              <button class="btn-plain" bindtap="closePractice">返回</button>
              <button class="btn-primary" bindtap="practiceSubmit"
                      disabled="{{practiceAnswer.length === 0}}">提交答案</button>
            </block>
            <block wx:else>
              <button class="btn-plain" bindtap="practiceRegenerate">再生成一题</button>
              <button class="btn-primary" bindtap="practiceSave" loading="{{practiceSaving}}"
                      disabled="{{practiceSaving}}">保存到错题本</button>
            </block>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
