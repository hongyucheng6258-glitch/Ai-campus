/* 代码纠错页样式 */
.row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label {
  font-size: 28rpx;
  color: #303133;
  margin-right: 20rpx;
}

.picker {
  font-size: 28rpx;
  color: #2f9e8a;
  padding: 8rpx 24rpx;
  background: #e6f4f0;
  border-radius: 8rpx;
}

.paste {
  margin-left: auto;
  font-size: 26rpx;
  color: #2f9e8a;
}

.code-area {
  width: 100%;
  height: 400rpx;
  background: #282c34;
  color: #abb2bf;
  font-size: 24rpx;
  line-height: 36rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-family: Consolas, Monaco, monospace;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: #909399;
  margin: 8rpx 0 20rpx;
}

.extra-area {
  width: 100%;
  height: 140rpx;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.btns {
  padding: 0 16rpx;
  display: flex;
}

.btns button {
  flex: 1;
  margin: 0 8rpx;
}

.btn-plain {
  background: #fff;
  color: #606266;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.answer {
  display: block;
  font-size: 26rpx;
  line-height: 44rpx;
  color: #606266;
  white-space: pre-wrap;
  word-break: break-all;
}

.copy {
  margin-top: 24rpx;
}
