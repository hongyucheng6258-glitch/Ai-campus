<view class="page">
  <view class="card">
    <textarea class="content-input" value="{{content}}" bindinput="onContentInput"
              maxlength="2000" placeholder="分享你的校园生活…" auto-height />
    <view class="char-count">{{content.length}}/2000</view>
  </view>

  <view class="image-section card">
    <view class="section-title">添加图片（{{images.length}}/9）</view>
    <view class="image-grid">
      <view wx:for="{{images}}" wx:key="*this" class="image-item">
        <image src="{{item}}" mode="aspectFill" class="preview-img"
               bindtap="previewImage" data-current="{{item}}" data-urls="{{images}}" />
        <view class="remove-btn" catchtap="removeImage" data-index="{{index}}">×</view>
      </view>
      <view wx:if="{{images.length < 9}}" class="add-btn" bindtap="chooseImages">
        <text class="plus">＋</text>
        <text class="add-text">添加</text>
      </view>
    </view>
  </view>

  <button class="submit-btn" loading="{{submitting}}" bindtap="submit">发布</button>
</view>
