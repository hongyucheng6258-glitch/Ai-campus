.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.cell {
  width: 160rpx;
  height: 160rpx;
  position: relative;
}
.img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}
.del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #d9543f;
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  line-height: 36rpx;
}
.add {
  border: 2rpx dashed #dcdfe6;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #c0c4cc;
}
