.item-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 16rpx;
}
.cover {
  width: 100%;
  height: 300rpx;
}
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c0c4cc;
  font-size: 24rpx;
  background: #f3f0ea;
}
.body {
  padding: 20rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tag {
  margin-right: 8rpx;
}
.desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #909399;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.extra {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #c0c4cc;
}
