/* 发布失物招领样式 */
.type-switch {
  display: flex;
  padding: 16rpx;
}

.type-switch .type {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  margin: 0 8rpx;
  font-size: 28rpx;
  color: #606266;
  background: #f3f0ea;
  border-radius: 12rpx;
}

.type-switch .type.active {
  background: #2f9e8a;
  color: #fff;
  font-weight: 600;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #606266;
  display: block;
  margin-bottom: 12rpx;
}

.req {
  color: #d9543f;
}

.input {
  width: 100%;
  height: 76rpx;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker {
  height: 76rpx;
  line-height: 76rpx;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #303133;
}

.dt-row {
  display: flex;
}

.dt-row picker {
  flex: 1;
  margin-right: 16rpx;
}

.dt-row picker:last-child {
  margin-right: 0;
}

.textarea {
  width: 100%;
  height: 200rpx;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.notice {
  margin: 0 32rpx 24rpx;
  font-size: 24rpx;
  color: #e0a93f;
  line-height: 36rpx;
}

.btns {
  padding: 0 32rpx 60rpx;
}
