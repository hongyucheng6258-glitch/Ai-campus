/* 活动列表样式 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
}

.search-input {
  flex: 1;
  height: 68rpx;
  background: #f3f0ea;
  border-radius: 34rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.search-btn,
.scan-btn {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #2f9e8a;
  flex-shrink: 0;
}

.tool-bar {
  display: flex;
  justify-content: flex-end;
  background: #fff;
  padding: 0 24rpx 12rpx;
}

.my-btn {
  font-size: 28rpx;
  color: #2f9e8a;
  flex-shrink: 0;
}

.tabs {
  white-space: nowrap;
  background: #fff;
  padding: 12rpx;
  display: flex;
  border-top: 1rpx solid #f3f0ea;
}

.tabs .tab {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin: 0 6rpx;
  font-size: 26rpx;
  color: #606266;
  background: #f3f0ea;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.tabs .tab.active {
  background: #2f9e8a;
  color: #fff;
}

.list-item {
  margin: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.loading-tip {
  text-align: center;
  color: #c0c4cc;
  font-size: 24rpx;
  padding: 24rpx 0 120rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2f9e8a;
  color: #fff;
  font-size: 56rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(47, 158, 138, 0.35);
  z-index: 10;
}
