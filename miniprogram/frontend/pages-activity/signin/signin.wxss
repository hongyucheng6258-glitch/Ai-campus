/* 活动签到样式 */
.scan-box {
  padding: 80rpx 60rpx 60rpx;
  text-align: center;
}

.scan-icon {
  font-size: 110rpx;
}

.scan-title {
  font-size: 36rpx;
  font-weight: 700;
  margin: 20rpx 0 12rpx;
}

.scan-sub {
  font-size: 26rpx;
  color: #909399;
  margin-bottom: 48rpx;
}

.result {
  font-size: 28rpx;
  color: #303133;
  line-height: 44rpx;
  text-align: center;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 76rpx;
  background: #f3f0ea;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.submit {
  margin-top: 24rpx;
}

.btn-plain {
  background: #f3f0ea;
  color: #606266;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.tips {
  padding: 24rpx 40rpx 60rpx;
  font-size: 24rpx;
  color: #c0c4cc;
  line-height: 42rpx;
}
