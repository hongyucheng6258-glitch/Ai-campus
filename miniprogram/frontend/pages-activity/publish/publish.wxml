<view class="page">
  <view class="card">
    <view class="form-item">
      <text class="label">活动标题 <text class="req">*</text></text>
      <input class="input" value="{{title}}" bindinput="onInput" data-field="title"
             placeholder="如：周末篮球友谊赛招队友" maxlength="64" />
    </view>

    <view class="form-item">
      <text class="label">活动分类</text>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}"
              bindchange="onCategoryChange">
        <view class="picker">{{categories[categoryIndex]}} ▾</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">活动地点</text>
      <input class="input" value="{{location}}" bindinput="onInput" data-field="location"
             placeholder="如：东区体育馆 3 号场" maxlength="128" />
    </view>

    <view class="form-item">
      <text class="label">开始时间 <text class="req">*</text></text>
      <view class="dt-row">
        <picker mode="date" value="{{startDate}}" bindchange="onDateTimeChange" data-field="startDate">
          <view class="picker">{{startDate || '选择日期'}} ▾</view>
        </picker>
        <picker mode="time" value="{{startTime}}" bindchange="onDateTimeChange" data-field="startTime">
          <view class="picker">{{startTime || '选择时间'}} ▾</view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <text class="label">结束时间 <text class="req">*</text></text>
      <view class="dt-row">
        <picker mode="date" value="{{endDate}}" bindchange="onDateTimeChange" data-field="endDate">
          <view class="picker">{{endDate || '选择日期'}} ▾</view>
        </picker>
        <picker mode="time" value="{{endTime}}" bindchange="onDateTimeChange" data-field="endTime">
          <view class="picker">{{endTime || '选择时间'}} ▾</view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <text class="label">报名截止 <text class="req">*</text></text>
      <view class="dt-row">
        <picker mode="date" value="{{deadlineDate}}" bindchange="onDateTimeChange" data-field="deadlineDate">
          <view class="picker">{{deadlineDate || '选择日期'}} ▾</view>
        </picker>
        <picker mode="time" value="{{deadlineTime}}" bindchange="onDateTimeChange" data-field="deadlineTime">
          <view class="picker">{{deadlineTime || '选择时间'}} ▾</view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <text class="label">人数上限</text>
      <input class="input" type="number" value="{{maxMembers}}" bindinput="onInput"
             data-field="maxMembers" placeholder="留空或填 0 表示不限人数" />
    </view>

    <view class="form-item">
      <text class="label">活动详情</text>
      <textarea class="textarea" value="{{description}}" bindinput="onInput" data-field="description"
                placeholder="活动流程、参与要求、注意事项等" maxlength="1000"
                show-confirm-bar="{{false}}" />
    </view>

    <view class="form-item">
      <text class="label">活动海报</text>
      <upload-grid value="{{images}}" max="{{6}}" bind:change="onImagesChange" />
    </view>
  </view>

  <view class="notice">活动需经管理员审核后展示。报名采用审批制，你可在详情页管理报名名单并生成签到码。</view>

  <view class="btns">
    <button class="btn-primary" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">
      提交发布
    </button>
  </view>
</view>
