<view class="page">
  <block wx:if="{{notice}}">
    <view class="card">
      <view class="title">{{notice.title}}</view>
      <view class="meta">
        <text class="tag">官方公告</text>
        <text class="time">{{notice.publishTimeText}}</text>
      </view>

      <image wx:if="{{notice.cover}}" class="cover" src="{{notice.cover}}" mode="widthFix"
             bindtap="previewCover" />

      <!-- 正文（Markdown 已降级为纯文本，长按可选中） -->
      <text class="content" selectable decode>{{notice.plainContent}}</text>
    </view>

    <view class="footer">
      <button class="btn-primary" bindtap="copyContent">复制公告内容</button>
    </view>
  </block>

  <view wx:elif="{{loading}}" class="empty">加载中…</view>
  <view wx:else class="empty">公告不存在或已下架</view>
</view>
