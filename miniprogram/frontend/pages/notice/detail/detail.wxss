/* 公告详情样式 */
.title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 52rpx;
  color: #303133;
}

.meta {
  margin: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta .time {
  font-size: 24rpx;
  color: #909399;
}

.cover {
  width: 100%;
  border-radius: 12rpx;
  margin: 20rpx 0;
}

.content {
  display: block;
  font-size: 28rpx;
  line-height: 48rpx;
  color: #606266;
  white-space: pre-wrap;
  word-break: break-all;
}

.footer {
  padding: 24rpx 32rpx 48rpx;
}
