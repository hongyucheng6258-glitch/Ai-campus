/* 公告列表样式 */
.page {
  padding-bottom: 40rpx;
}

.notice {
  display: flex;
  align-items: center;
}

.notice .cover {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.notice .info {
  flex: 1;
  overflow: hidden;
}

.notice .title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  line-height: 44rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.notice .meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notice .time {
  font-size: 24rpx;
  color: #909399;
}

.loading-tip {
  text-align: center;
  color: #c0c4cc;
  font-size: 24rpx;
  padding: 24rpx 0;
}
