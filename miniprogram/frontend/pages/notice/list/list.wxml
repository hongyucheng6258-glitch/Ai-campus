<view class="page">
  <!-- 公告列表 -->
  <view wx:for="{{list}}" wx:key="id" class="card notice" bindtap="goDetail" data-id="{{item.id}}">
    <image wx:if="{{item.cover}}" class="cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
    <view class="info">
      <view class="title">{{item.title}}</view>
      <view class="meta">
        <text class="tag">官方公告</text>
        <text class="time">{{item.publishTimeText}}</text>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view wx:if="{{inited && list.length === 0}}" class="empty">暂无公告</view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-tip">加载中…</view>
  <view wx:elif="{{!hasMore && list.length > 0}}" class="loading-tip">没有更多了</view>
</view>
