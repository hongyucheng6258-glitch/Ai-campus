/* 我的页面样式 */
.profile {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2f9e8a, #7fc7b6);
  padding: 48rpx 32rpx;
  color: #fff;
}

.profile .avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  flex-shrink: 0;
}

.profile .avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
}

.profile .info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.profile .nickname {
  font-size: 34rpx;
  font-weight: 700;
}

.profile .sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.login-btn {
  background: #fff;
  color: #2f9e8a;
  font-size: 26rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid .cell {
  width: 25%;
  text-align: center;
  padding: 20rpx 0;
}

.grid .icon {
  font-size: 48rpx;
}

.grid .name {
  font-size: 24rpx;
  color: #606266;
  margin-top: 8rpx;
}

.tabs {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 12rpx;
  display: flex;
}

.tabs .tab {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin: 0 6rpx;
  font-size: 26rpx;
  color: #606266;
  background: #f3f0ea;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.tabs .tab.active {
  background: #2f9e8a;
  color: #fff;
}

.list-item {
  margin: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.loading-tip {
  text-align: center;
  color: #c0c4cc;
  font-size: 24rpx;
  padding: 24rpx 0;
}

.footer {
  padding: 32rpx 32rpx 64rpx;
}

.logout {
  background: #fff;
  color: #d9543f;
  border-radius: 44rpx;
  font-size: 30rpx;
}
