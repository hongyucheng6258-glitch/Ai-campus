.page {
  min-height: 100vh;
  padding: 120rpx 48rpx 48rpx;
  box-sizing: border-box;
}

.logo {
  text-align: center;
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #303133;
}

.sub {
  margin: 12rpx 0 60rpx;
  text-align: center;
  color: #909399;
  font-size: 26rpx;
}

.form {
  width: 100%;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f3f0ea;
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}
