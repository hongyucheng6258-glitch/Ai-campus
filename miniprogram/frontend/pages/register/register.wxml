<view class="page">
  <view class="logo">📝</view>
  <view class="title">注册账号</view>
  <view class="sub">注册后可在 Web 端和小程序端使用同一账号</view>

  <view class="form card">
    <input class="input" placeholder="学号" value="{{studentNo}}" bindinput="onInput" data-key="studentNo" />
    <input class="input" placeholder="昵称" value="{{nickname}}" bindinput="onInput" data-key="nickname" />
    <input class="input" placeholder="密码（至少6位）" password value="{{password}}" bindinput="onInput" data-key="password" />
    <input class="input" placeholder="确认密码" password value="{{confirmPassword}}" bindinput="onInput" data-key="confirmPassword" />
    <button class="btn-primary" loading="{{registering}}" bindtap="register">注册并登录</button>
  </view>
</view>
