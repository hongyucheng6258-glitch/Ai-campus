/* 登录页样式（login.wxss）
 * 补齐首屏基础样式：page/logo/title/sub/login-btn/input/bind-* 在 app.wxss 中未定义，
 * 此处补充；page、.card、.btn-primary 已在全球样式中，可直接复用。 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx 48rpx;
  box-sizing: border-box;
}

.logo {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 12rpx;
}

.sub {
  font-size: 26rpx;
  color: #909399;
  margin-bottom: 80rpx;
  text-align: center;
}

/* 一键登录按钮：复用全局 .btn-primary，这里仅补宽度与间距 */
.login-btn {
  width: 100%;
  margin-top: 24rpx;
}

/* 绑定学号面板：复用全局 .card，这里补宽度 */
.bind-panel {
  width: 100%;
  margin-top: 32rpx;
}

.bind-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 8rpx;
}

.bind-tip {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* 输入框：复用全局未定义，这里补齐 */
.input {
  width: 100%;
  height: 88rpx;
  background: #f3f0ea;
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #303133;
}

.skip {
  text-align: center;
  font-size: 26rpx;
  color: #2f9e8a;
  margin-top: 16rpx;
}
