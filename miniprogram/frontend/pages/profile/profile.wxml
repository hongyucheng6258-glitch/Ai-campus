<view class="page">
  <view class="hero card">
    <view class="avatar-wrap" bindtap="chooseAvatar">
      <image wx:if="{{userInfo.avatar}}" class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
      <view wx:else class="avatar placeholder">{{userInfo.nickname ? userInfo.nickname[0] : '同'}}</view>
      <view class="avatar-edit">更换头像</view>
    </view>
    <view class="hero-text">点击头像更换</view>
  </view>

  <view class="section card">
    <view class="section-title">个人资料</view>
    <view class="field"><text>学号</text><text class="readonly">{{userInfo.studentNo || '未绑定'}}</text></view>
    <view class="field"><text>昵称</text><input value="{{nickname}}" data-key="nickname" bindinput="onInput" /></view>
    <view class="field"><text>手机号</text><input value="{{phone}}" data-key="phone" type="number" bindinput="onInput" placeholder="可选" /></view>
    <view class="field"><text>性别</text><picker mode="selector" range="{{['未知','男','女']}}" value="{{gender}}" bindchange="onGenderChange"><text>{{gender === 1 ? '男' : gender === 2 ? '女' : '未知'}}</text></picker></view>
    <view class="field textarea-field"><text>简介</text><textarea value="{{bio}}" data-key="bio" bindinput="onInput" maxlength="120" placeholder="介绍一下自己" /></view>
    <button class="btn-primary" loading="{{saving}}" bindtap="saveProfile">保存资料</button>
  </view>

  <view class="section card">
    <view class="section-title">修改密码</view>
    <input class="password" password value="{{oldPassword}}" data-key="oldPassword" bindinput="onInput" placeholder="原密码" />
    <input class="password" password value="{{newPassword}}" data-key="newPassword" bindinput="onInput" placeholder="新密码（至少6位）" />
    <button class="btn-secondary" loading="{{changingPassword}}" bindtap="changePassword">修改密码</button>
  </view>
</view>
