.page { padding: 24rpx; }
.hero { display: flex; flex-direction: column; align-items: center; padding: 40rpx; background: linear-gradient(145deg, #236b5d, #63b39f); }
.avatar-wrap { position: relative; width: 168rpx; height: 168rpx; }
.avatar { width: 168rpx; height: 168rpx; border-radius: 50%; border: 6rpx solid rgba(255,255,255,.72); background: rgba(255,255,255,.2); }
.avatar.placeholder { display: flex; align-items: center; justify-content: center; color: #fff; font-size: 60rpx; }
.avatar-edit { position: absolute; left: 50%; bottom: -10rpx; transform: translateX(-50%); padding: 8rpx 18rpx; border-radius: 24rpx; background: #fff; color: #236b5d; font-size: 22rpx; white-space: nowrap; }
.hero-text { margin-top: 28rpx; color: rgba(255,255,255,.82); font-size: 24rpx; }
.section { margin-top: 24rpx; padding: 28rpx; }
.section-title { margin-bottom: 12rpx; color: #26332f; font-size: 32rpx; font-weight: 700; }
.field { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid #eee9df; color: #52605b; font-size: 28rpx; }
.field input, .field picker { width: 440rpx; text-align: right; color: #26332f; }
.readonly { color: #9a9e9c; }
.textarea-field { align-items: flex-start; padding: 24rpx 0; }
.textarea-field textarea { width: 440rpx; min-height: 140rpx; text-align: right; color: #26332f; }
.password { box-sizing: border-box; width: 100%; height: 88rpx; margin-top: 18rpx; padding: 0 22rpx; border-radius: 14rpx; background: #f5f1e9; }
.btn-primary, .btn-secondary { margin-top: 28rpx; border-radius: 999rpx; font-size: 28rpx; }
.btn-primary { background: #236b5d; color: #fff; }
.btn-secondary { background: #fff; color: #236b5d; border: 2rpx solid #236b5d; }
.btn-primary::after, .btn-secondary::after { border: none; }
