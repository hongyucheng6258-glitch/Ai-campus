.page {
  padding: 24rpx;
}

.card {
  padding: 32rpx;
  border-radius: 20rpx;
  background: #fff;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #26332f;
}

.desc,
.hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8c939d;
  line-height: 1.6;
}

.input {
  box-sizing: border-box;
  width: 100%;
  height: 92rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f5f1e9;
  color: #26332f;
  font-size: 28rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.btn::after {
  border: none;
}

.primary {
  background: #236b5d;
  color: #fff;
}

.secondary {
  background: #fff;
  color: #236b5d;
  border: 2rpx solid #236b5d;
}
