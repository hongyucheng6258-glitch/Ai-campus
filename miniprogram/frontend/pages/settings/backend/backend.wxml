<view class="page">
  <view class="card">
    <view class="title">后端地址设置</view>
    <view class="desc">选择预设环境或手动输入后端地址，保存后立即生效。</view>

    <view class="presets">
      <view class="preset-label">快速选择</view>
      <view class="preset-list">
        <view
          wx:for="{{presets}}"
          wx:key="value"
          class="preset-item {{activePreset === index ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="selectPreset"
        >
          <view class="preset-name">{{item.label}}</view>
          <view class="preset-url">{{item.value}}</view>
        </view>
      </view>
    </view>

    <view class="input-label">自定义地址</view>
    <input class="input" value="{{apiBaseUrl}}" placeholder="http://43.143.248.211/api" bindinput="onInput" />
    <view class="hint">直接输入 host:port 会自动补 /api 后缀；保存后写入本地存储，所有请求和上传都会使用该地址。</view>

    <view class="actions">
      <button class="btn secondary" bindtap="reset">恢复默认</button>
      <button class="btn primary" loading="{{saving}}" bindtap="save">保存</button>
    </view>
  </view>
</view>
