<view class="page">
  <block wx:if="{{logged}}">
    <view class="status"><text class="status-dot"></text>{{connectionText}}</view>
    <view wx:for="{{list}}" wx:key="id" class="conversation" bindtap="openRoom" data-id="{{item.id}}">
      <image wx:if="{{item.peerAvatar}}" class="avatar" src="{{item.peerAvatar}}" mode="aspectFill" />
      <view wx:else class="avatar placeholder">{{item.peerNickname ? item.peerNickname[0] : '同'}}</view>
      <view class="main">
        <view class="top">
          <text class="name">{{item.peerNickname || '校园用户'}}</text>
          <text class="time">{{item.timeText}}</text>
        </view>
        <view class="bottom">
          <text class="summary">{{item.summary}}</text>
          <text wx:if="{{item.unreadCount > 0}}" class="badge">{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</text>
        </view>
        <view wx:if="{{item.contextTitle}}" class="context">来自：{{item.contextTitle}}</view>
      </view>
    </view>
    <view wx:if="{{inited && list.length === 0}}" class="empty">暂无私信会话</view>
    <view wx:if="{{loading}}" class="loading">加载中…</view>
  </block>
  <view wx:else class="login-tip">
    <view class="empty">登录后查看你的私信</view>
    <button class="btn-primary" bindtap="goLogin">立即登录</button>
  </view>
</view>
