<view class="room">
  <view class="connection">{{connectionText}}</view>
  <view wx:if="{{conversation.contextTitle}}" class="context" bindtap="openContext">
    <view class="context-label">本次沟通来自</view>
    <view class="context-title">{{conversation.contextTitle}} <text>›</text></view>
  </view>
  <scroll-view class="messages" scroll-y scroll-into-view="{{scrollIntoView}}" enhanced show-scrollbar="{{false}}">
    <view wx:if="{{!historyDone}}" class="history" bindtap="loadHistory">{{historyLoading ? '加载中…' : '加载更早消息'}}</view>
    <view wx:else class="history">没有更早消息了</view>
    <view wx:for="{{messages}}" wx:key="clientMessageId" class="row {{item.mine ? 'mine' : ''}}">
      <image wx:if="{{!item.mine && conversation.peerAvatar}}" class="avatar" src="{{conversation.peerAvatar}}" mode="aspectFill" />
      <view wx:elif="{{!item.mine}}" class="avatar placeholder">{{conversation.peerNickname ? conversation.peerNickname[0] : '同'}}</view>
      <view class="bubble-wrap">
        <view wx:if="{{item.messageType === 'image'}}" class="bubble image-bubble">
          <image class="message-image" src="{{item.content}}" mode="widthFix" bindtap="previewImage" data-url="{{item.content}}" />
        </view>
        <view wx:else class="bubble text-bubble">{{item.content}}</view>
        <view class="meta">
          <text>{{item.timeText}}</text>
          <text wx:if="{{item.mine && item.sendState === 'sending'}}"> · 发送中</text>
          <text wx:if="{{item.mine && item.sendState === 'failed'}}" class="failed" bindtap="retry" data-index="{{index}}"> · 发送失败，点此重试</text>
          <text wx:if="{{item.mine && item.sendState === 'sent'}}"> · {{item.readTime ? '已读' : '未读'}}</text>
        </view>
      </view>
    </view>
    <view id="message-end" class="message-end"></view>
  </scroll-view>
  <view class="composer">
    <button class="image-button" bindtap="chooseImage" loading="{{sendingImage}}">图片</button>
    <textarea class="input" value="{{inputValue}}" bindinput="onInput" maxlength="2000" auto-height placeholder="输入消息" cursor-spacing="20" />
    <button class="send" bindtap="sendText">发送</button>
  </view>
</view>
