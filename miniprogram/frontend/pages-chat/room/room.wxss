.room { display: flex; height: 100vh; flex-direction: column; background: #faf7f1; }
.connection { padding: 8rpx 24rpx; color: #9a9ea4; background: #fff; font-size: 22rpx; text-align: center; }
.context { margin: 12rpx 16rpx 0; padding: 18rpx 22rpx; border: 1rpx solid #cfe7e1; border-radius: 16rpx; background: #e6f4f0; }
.context-label { color: #5b6066; font-size: 21rpx; }
.context-title { overflow: hidden; color: #236b5d; font-size: 26rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.messages { min-height: 0; flex: 1; padding: 0 20rpx; box-sizing: border-box; }
.history { padding: 20rpx 0; color: #9a9ea4; font-size: 22rpx; text-align: center; }
.row { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 24rpx; }
.row.mine { justify-content: flex-end; }
.avatar { width: 64rpx; height: 64rpx; flex-shrink: 0; border-radius: 50%; }
.avatar.placeholder { display: flex; align-items: center; justify-content: center; color: #fff; background: #8fcfc0; }
.bubble-wrap { max-width: 74%; }
.mine .bubble-wrap { display: flex; align-items: flex-end; flex-direction: column; }
.bubble { overflow: hidden; border-radius: 20rpx; box-shadow: 0 2rpx 8rpx rgba(53, 57, 61, .05); }
.text-bubble { padding: 18rpx 22rpx; color: #35393d; background: #fff; line-height: 1.55; word-break: break-all; }
.mine .text-bubble { color: #fff; background: #2f9e8a; }
.image-bubble { background: #fff; }
.message-image { display: block; width: 360rpx; max-height: 520rpx; }
.meta { margin-top: 6rpx; color: #9a9ea4; font-size: 19rpx; }
.failed { color: #d9543f; }
.message-end { height: 12rpx; }
.composer { display: flex; align-items: flex-end; gap: 12rpx; padding: 16rpx 18rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e7e3d9; background: #fff; }
.input { min-height: 66rpx; max-height: 180rpx; flex: 1; padding: 13rpx 18rpx; border-radius: 18rpx; background: #f4f2ed; box-sizing: border-box; font-size: 27rpx; }
.image-button, .send { width: auto; min-width: 96rpx; height: 66rpx; margin: 0; padding: 0 18rpx; border-radius: 32rpx; font-size: 25rpx; line-height: 66rpx; }
.image-button { color: #236b5d; background: #e6f4f0; }
.send { color: #fff; background: #2f9e8a; }
